  {
    "id": "comment-setup",
    "type": "comment",
    "z": "tab-opcua",
    "name": "1) Create the three variables once at startup",
    "info": "",
    "x": 290,
    "y": 80,
    "wires": []
  },
  {
    "id": "add-temp",
    "type": "inject",
    "z": "tab-opcua",
    "name": "addVariable Temperature",
    "props": [
      { "p": "payload" },
      { "p": "topic", "vt": "str" }
    ],
    "repeat": "",
    "crontab": "",
    "once": true,
    "onceDelay": 1,
    "topic": "ns=1;s=Temperature;datatype=Double",
    "payload": "{\"opcuaCommand\": \"addVariable\"}",
    "payloadType": "json",
    "x": 310,
    "y": 140,
    "wires": [
      [ "cfg-opcua-server" ]
    ]
  },
  {
